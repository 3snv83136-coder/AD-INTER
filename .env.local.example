# Auth NextAuth
NEXTAUTH_SECRET=                    # openssl rand -base64 32
NEXTAUTH_URL=https://ad-inter.vercel.app

# Admin bootstrap — identifiant identique, 4 mots de passe possibles.
# OBLIGATOIRE : sans AUTH_USER_1, le middleware désactive l'authentification.
AUTH_USER_1=admin
# Quatre accès admin (même identifiant)
AUTH_ADMIN_PASSWORDS=3110,1004,3112,3005

# --- Comptes techniciens : gérés EN BASE (table techniciens, migration 013) ---
# Les ~15 comptes terrain se créent depuis l'admin → /admin/techniciens.

# APIs
DEEPSEEK_API_KEY=sk-...               # Obligatoire en prod (génération IA)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Publication sur le site (API backend)
PUBLISH_API_URL=https://allodebouchage.com
PUBLISH_API_TOKEN=

# Identité légale (KBIS — aussi en table parametres)
ALLO_SIREN=
ALLO_SIRET=
NEXT_PUBLIC_ALLO_SIRET=
ALLO_TVA_INTRACOM=
ALLO_RCS=
ALLO_IBAN=
ALLO_BIC=
NEXT_PUBLIC_ALLO_RC_PRO=

# Resend (envoi email)
RESEND_API_KEY=re_...                # https://resend.com → API Keys
RESEND_FROM=Allo Débouchage <contact@allodebouchage.com>

# App terrain Expo — URL des APIs (le téléphone parle au même backend)
# En local : http://IP-LAN:3000  |  prod : NEXTAUTH_URL
# EXPO_PUBLIC_API_URL se définit dans mobile/.env

# PostgreSQL Supabase (Allo débouchage CRM)
# Remplacer [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# Vercel Blob (PDFs, photos, vidéos)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ----- OAuth réseaux (Vercel : URIs en https://ad-inter.vercel.app/api/oauth/...) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://ad-inter.vercel.app/api/oauth/google/callback

GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
GMB_REDIRECT_URI=https://ad-inter.vercel.app/api/oauth/gmb/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://ad-inter.vercel.app/api/oauth/facebook/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://ad-inter.vercel.app/api/oauth/tiktok/callback
