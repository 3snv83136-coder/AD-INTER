# Auth NextAuth
NEXTAUTH_SECRET=                    # openssl rand -base64 32
NEXTAUTH_URL=https://app-realisations.vercel.app

# Admin bootstrap (identifiant seul, sans mot de passe) — accès de secours toujours dispo.
# OBLIGATOIRE : sans AUTH_USER_1, le middleware désactive l'authentification.
AUTH_USER_1=admin

# --- Comptes techniciens : gérés EN BASE (table techniciens, migration 013) ---
# Les ~15 comptes terrain se créent depuis l'admin → /admin/techniciens.
# Plus besoin d'une variable d'env par technicien : login + mot de passe + rôle en base.

# (Compat héritée — comptes tech par variable d'env, optionnel)
# AUTH_TECH_1=technicien1:$2b$10$...:uuid-du-technicien-dans-supabase

# APIs
DEEPSEEK_API_KEY=sk-...               # Obligatoire en prod (génération IA)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Publication sur le site (API backend)
PUBLISH_API_URL=https://allodebouchage.com
PUBLISH_API_TOKEN=

# Identité légale (KBIS — aussi en table parametres Supabase)
ALLO_SIREN=
ALLO_SIRET=
NEXT_PUBLIC_ALLO_SIRET=
ALLO_TVA_INTRACOM=
ALLO_RCS=
ALLO_IBAN=
ALLO_BIC=
NEXT_PUBLIC_ALLO_RC_PRO=

# Resend (envoi email)
RESEND_API_KEY=re_...                # https://resend.com → API Keys
RESEND_FROM=Allo Débouchage <contact@allodebouchage.com>

# Supabase (CRM / historique / base de données)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # Project Settings → Data API → service_role

# ----- OAuth réseaux (Vercel : URIs en https://app-allo-debouchage.vercel.app/api/oauth/...) -----
# YouTube (Google Cloud → credentials OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app-allo-debouchage.vercel.app/api/oauth/google/callback

# Google Business Profile (autre client OAuth si besoin)
GMB_CLIENT_ID=
GMB_CLIENT_SECRET=
GMB_REDIRECT_URI=https://app-allo-debouchage.vercel.app/api/oauth/gmb/callback

# Facebook + Instagram (Meta for Developers → même app)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=https://app-allo-debouchage.vercel.app/api/oauth/facebook/callback

# TikTok (developers.tiktok.com)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app-allo-debouchage.vercel.app/api/oauth/tiktok/callback
